# Ignore everything by default
*

# But not these files/patterns
!.gitignore
!README.md
!*.csv
!*.Rmd
!*.R
!*.png
!*.jpg
!*.jpeg

# Allow directories to be traversed (but their contents will still be filtered)
!*/

# Explicitly ignore these even if they match above patterns
*.pdf
*.PDF
*.docx
*.doc
*.docm
*.DOCX
*.DOC

# Ignore temporary and generated files
~$*
*.tmp
*.bak

# Ignore R session files
.RData
.Rhistory
.Rproj.user/

# Ignore NetCDF data files
*.nc

# Ignore HTML output files
*.html

# Ignore cache directories
*_cache/
*_files/
