# TMA Mann-Kendall
mkout_tma <- run_mk(x_tma)
# ERA5-Land Mann-Kendall
mkout_era5 <- run_mk(x_era5)
trend_results <- rbind(trend_results, data.frame(
Season = s,
Variable = label,
TMA_Z = round(mkout_tma$Z, 4),
TMA_p_value = round(mkout_tma$p, 5),
TMA_Sen_slope = round(mkout_tma$slope, 5),
TMA_CI_lower = round(mkout_tma$ci_lower, 5),
TMA_CI_upper = round(mkout_tma$ci_upper, 5),
ERA5_Z = round(mkout_era5$Z, 4),
ERA5_p_value = round(mkout_era5$p, 5),
ERA5_Sen_slope = round(mkout_era5$slope, 5),
ERA5_CI_lower = round(mkout_era5$ci_lower, 5),
ERA5_CI_upper = round(mkout_era5$ci_upper, 5)
))
}
}
}
# Calculate Bonferroni correction
n_tests <- nrow(trend_results)
trend_results$TMA_p_bonferroni <- pmin(trend_results$TMA_p_value * n_tests, 1)
trend_results$ERA5_p_bonferroni <- pmin(trend_results$ERA5_p_value * n_tests, 1)
# Display TMA results table
trend_results %>%
mutate(
TMA_Sen_slope_CI = paste0(round(TMA_Sen_slope, 5), " [", round(TMA_CI_lower, 5), ", ", round(TMA_CI_upper, 5), "]"),
TMA_p_corrected = round(TMA_p_bonferroni, 5)
) %>%
select(Season, Variable, TMA_Z, TMA_p_value, TMA_p_corrected, TMA_Sen_slope_CI) %>%
kable(
format = "html",
caption = "Mann-Kendall Trend Test Results for TMA Data (2014-2024)",
col.names = c("Season", "Variable", "Z-Score", "p-value", "p-value (Bonferroni)", "Sen's slope [95% CI]"),
digits = 5
) %>%
kable_styling(full_width = FALSE, bootstrap_options = c("striped", "hover"))
# Display ERA5-Land results table (Absolute Extremes)
trend_results %>%
mutate(
ERA5_Sen_slope_CI = paste0(round(ERA5_Sen_slope, 5), " [", round(ERA5_CI_lower, 5), ", ", round(ERA5_CI_upper, 5), "]"),
ERA5_p_corrected = round(ERA5_p_bonferroni, 5)
) %>%
select(Season, Variable, ERA5_Z, ERA5_p_value, ERA5_p_corrected, ERA5_Sen_slope_CI) %>%
kable(
format = "html",
caption = "Mann-Kendall Trend Test Results for ERA5-Land Data - Absolute Extremes (2014-2024)",
col.names = c("Season", "Variable", "Z-Score", "p-value", "p-value (Bonferroni)", "Sen's slope [95% CI]"),
digits = 5
) %>%
kable_styling(full_width = FALSE, bootstrap_options = c("striped", "hover"))
# Create comparison summary table
comparison_summary <- trend_results %>%
mutate(
TMA_Direction = ifelse(TMA_Sen_slope > 0, "Increasing", "Decreasing"),
ERA5_Direction = ifelse(ERA5_Sen_slope > 0, "Increasing", "Decreasing"),
TMA_Sig = ifelse(TMA_p_value < 0.05, "Significant", "Not Significant"),
ERA5_Sig = ifelse(ERA5_p_value < 0.05, "Significant", "Not Significant"),
Direction_Match = ifelse(TMA_Direction == ERA5_Direction, "Yes", "No"),
Significance_Match = ifelse(TMA_Sig == ERA5_Sig, "Yes", "No")
)
comparison_summary %>%
select(Season, Variable,
TMA_Z, TMA_p_value, TMA_Direction, TMA_Sig,
ERA5_Z, ERA5_p_value, ERA5_Direction, ERA5_Sig,
Direction_Match, Significance_Match) %>%
kable(
format = "html",
caption = "Trend Comparison: TMA vs ERA5-Land Absolute Extremes (using same Mann-Kendall methodology)",
col.names = c("Season", "Variable",
"TMA Z", "TMA p", "TMA Dir", "TMA Sig",
"ERA5 Z", "ERA5 p", "ERA5 Dir", "ERA5 Sig",
"Dir Match", "Sig Match"),
digits = 4
) %>%
kable_styling(full_width = FALSE, bootstrap_options = c("striped", "hover"))
# Count matches
n_total <- nrow(comparison_summary)
n_direction_match <- sum(comparison_summary$Direction_Match == "Yes")
n_sig_match <- sum(comparison_summary$Significance_Match == "Yes")
cat("\n\nSUMMARY:\n")
cat(sprintf("Direction agreement: %d/%d (%.0f%%)\n", n_direction_match, n_total, 100*n_direction_match/n_total))
cat(sprintf("Significance agreement: %d/%d (%.0f%%)\n", n_sig_match, n_total, 100*n_sig_match/n_total))
knitr::opts_chunk$set(echo = TRUE)
library(readr)
library(dplyr)
library(Kendall)
library(trend)
library(knitr)
library(kableExtra)
library(ggplot2)
library(tidyr)
library(broom)
df <- read_csv("CLIMATE DAR DATASET.csv")
df$date <- as.Date(paste(df$Year, df$Month, "01", sep = "-"), format="%Y-%b-%d")
vars <- c("rainfall_mm",
"daytime_temperature_celcius",
"nighttime_temperature_celcius",
"relative_humidity_%")
var_labels <- c("Rainfall (mm)",
"Daytime Temperature (°C)",
"Nighttime Temperature (°C)",
"Relative Humidity (%)")
# Function to run OLS regression
run_ols <- function(x) {
n <- length(x)
t <- 1:n
# Fit linear model
model <- lm(x ~ t)
summary_model <- summary(model)
# Extract coefficients
coef_table <- coef(summary_model)
slope <- coef_table["t", "Estimate"]
se <- coef_table["t", "Std. Error"]
t_stat <- coef_table["t", "t value"]
p_value <- coef_table["t", "Pr(>|t|)"]
# R-squared
r_squared <- summary_model$r.squared
adj_r_squared <- summary_model$adj.r.squared
# Calculate 95% confidence interval for slope
ci <- confint(model, "t", level = 0.95)
ci_lower <- ci[1]
ci_upper <- ci[2]
return(list(
slope = slope,
se = se,
t_stat = t_stat,
p_value = p_value,
r_squared = r_squared,
adj_r_squared = adj_r_squared,
ci_lower = ci_lower,
ci_upper = ci_upper
))
}
# Run OLS for each season and variable
ols_results <- data.frame()
for (s in unique(df$Season)) {
sub_data <- df %>% filter(Season == s) %>% arrange(date)
for (i in seq_along(vars)) {
v <- vars[i]
label <- var_labels[i]
x <- sub_data[[v]]
if (length(x) >= 8) {
ols_out <- run_ols(x)
ols_results <- rbind(ols_results, data.frame(
Season = s,
Variable = label,
OLS_Slope = round(ols_out$slope, 5),
SE = round(ols_out$se, 5),
t_statistic = round(ols_out$t_stat, 4),
p_value = round(ols_out$p_value, 5),
R_squared = round(ols_out$r_squared, 4),
CI_lower = round(ols_out$ci_lower, 5),
CI_upper = round(ols_out$ci_upper, 5)
))
}
}
}
# Calculate Bonferroni correction
n_tests <- nrow(ols_results)
ols_results$p_value_bonferroni <- pmin(ols_results$p_value * n_tests, 1)
# Display OLS results table
ols_results %>%
mutate(
OLS_slope_CI = paste0(round(OLS_Slope, 5), " [", round(CI_lower, 5), ", ", round(CI_upper, 5), "]"),
p_value_corrected = round(p_value_bonferroni, 5)
) %>%
select(Season, Variable, t_statistic, p_value, p_value_corrected, OLS_slope_CI, R_squared) %>%
kable(
format = "html",
caption = "OLS Regression Trend Test Results for Seasonal Climatic Variables (2014–2024)",
col.names = c("Season", "Variable", "t-statistic", "p-value", "p-value (Bonferroni)", "OLS Slope [95% CI]", "R²"),
digits = 5
) %>%
kable_styling(full_width = FALSE, bootstrap_options = c("striped", "hover")) %>%
footnote(
general = "OLS slope represents the average rate of change per time unit. R² indicates the proportion of variance explained by the linear trend. Bonferroni correction applied for multiple comparisons.",
general_title = "Note:"
)
# Run Mann-Kendall for comparison
run_mk <- function(x) {
mk <- MannKendall(x)
sen_result <- sens.slope(x)
sen <- sen_result$estimates
sen_ci <- sen_result$conf.int
S <- mk$S
varS <- mk$varS
if (varS > 0) {
if (S > 0) {
Z <- (S - 1) / sqrt(varS)
} else if (S == 0) {
Z <- 0
} else {
Z <- (S + 1) / sqrt(varS)
}
} else {
Z <- 0
}
return(list(Z = Z, p = mk$sl, slope = sen, ci_lower = sen_ci[1], ci_upper = sen_ci[2]))
}
# Run MK for each season and variable
mk_results <- data.frame()
for (s in unique(df$Season)) {
sub_data <- df %>% filter(Season == s) %>% arrange(date)
for (i in seq_along(vars)) {
v <- vars[i]
label <- var_labels[i]
x <- sub_data[[v]]
if (length(x) >= 8) {
mkout <- run_mk(x)
mk_results <- rbind(mk_results, data.frame(
Season = s,
Variable = label,
MK_Z = round(mkout$Z, 4),
MK_p_value = round(mkout$p, 5),
Sen_slope = round(mkout$slope, 5)
))
}
}
}
# Merge OLS and MK results
comparison <- ols_results %>%
select(Season, Variable, OLS_Slope, t_statistic, p_value, R_squared) %>%
rename(OLS_p_value = p_value, OLS_t = t_statistic) %>%
left_join(mk_results, by = c("Season", "Variable"))
# Determine agreement between methods
comparison <- comparison %>%
mutate(
OLS_sig = OLS_p_value < 0.05,
MK_sig = MK_p_value < 0.05,
OLS_direction = ifelse(OLS_Slope > 0, "Increasing", "Decreasing"),
MK_direction = ifelse(Sen_slope > 0, "Increasing", "Decreasing"),
Significance_Agreement = ifelse(OLS_sig == MK_sig, "Yes", "No"),
Direction_Agreement = ifelse(OLS_direction == MK_direction, "Yes", "No"),
Full_Agreement = ifelse(Significance_Agreement == "Yes" & Direction_Agreement == "Yes", "Yes", "No")
)
# Display comparison table
comparison %>%
mutate(
OLS_Result = paste0("β=", round(OLS_Slope, 5), ", t=", round(OLS_t, 3), ", p=", round(OLS_p_value, 4)),
MK_Result = paste0("Sen=", round(Sen_slope, 5), ", Z=", round(MK_Z, 3), ", p=", round(MK_p_value, 4)),
OLS_Sig = ifelse(OLS_sig, "Sig*", "NS"),
MK_Sig = ifelse(MK_sig, "Sig*", "NS")
) %>%
select(Season, Variable, OLS_Result, OLS_Sig, MK_Result, MK_Sig, Direction_Agreement, Full_Agreement) %>%
kable(
format = "html",
caption = "Comparison of OLS Regression and Mann–Kendall Trend Test Results (2014–2024)",
col.names = c("Season", "Variable", "OLS Result", "OLS Sig.", "Mann–Kendall Result", "MK Sig.", "Direction Match", "Full Agreement"),
digits = 5
) %>%
kable_styling(full_width = FALSE, bootstrap_options = c("striped", "hover")) %>%
footnote(
general = "Sig* = Significant at p < 0.05; NS = Not Significant. Direction Match indicates whether both methods detect the same trend direction. Full Agreement indicates whether both methods agree on significance AND direction.",
general_title = "Note:"
)
# Scatter plot comparing slopes
slope_comparison <- comparison %>%
select(Season, Variable, OLS_Slope, Sen_slope)
p_slope <- ggplot(slope_comparison, aes(x = Sen_slope, y = OLS_Slope)) +
geom_point(aes(color = Season), size = 3, alpha = 0.7) +
geom_abline(intercept = 0, slope = 1, linetype = "dashed", color = "red", linewidth = 1) +
geom_smooth(method = "lm", se = TRUE, color = "blue", alpha = 0.2) +
labs(
title = "Comparison of Trend Slopes: OLS vs. Sen's Slope",
subtitle = "Red dashed line shows 1:1 relationship; blue line shows linear fit",
x = "Sen's Slope (Mann–Kendall)",
y = "OLS Slope (Linear Regression)",
color = "Season"
) +
theme_minimal() +
theme(
plot.title = element_text(size = 14, face = "bold"),
plot.subtitle = element_text(size = 11),
legend.position = "bottom"
) +
scale_color_brewer(palette = "Set2")
print(p_slope)
ggsave("ols_vs_mk_slope_comparison.png", p_slope, width = 8, height = 6, dpi = 300)
# Correlation between slopes
slope_cor <- cor(slope_comparison$OLS_Slope, slope_comparison$Sen_slope, use = "complete.obs")
cat("Correlation between OLS slope and Sen's slope:", round(slope_cor, 4), "\n")
slope_comparison %>%
mutate(
Slope_Difference = round(OLS_Slope - Sen_slope, 5),
Pct_Difference = round(100 * (OLS_Slope - Sen_slope) / abs(Sen_slope), 2)
) %>%
kable(
format = "html",
caption = "Detailed Comparison of OLS and Sen's Slopes",
col.names = c("Season", "Variable", "OLS Slope", "Sen's Slope", "Difference (OLS - Sen)", "% Difference"),
digits = 5
) %>%
kable_styling(full_width = FALSE, bootstrap_options = c("striped", "hover")) %>%
footnote(
general = "Positive difference indicates OLS slope is larger than Sen's slope. Sen's slope is more robust to outliers as it uses median rather than mean.",
general_title = "Note:"
)
# Function to run OLS diagnostics
get_ols_diagnostics <- function(x) {
n <- length(x)
t <- 1:n
model <- lm(x ~ t)
# Shapiro-Wilk test for normality of residuals
if (n >= 3 && n <= 5000) {
shapiro_test <- shapiro.test(residuals(model))
shapiro_p <- shapiro_test$p.value
} else {
shapiro_p <- NA
}
# Durbin-Watson test for autocorrelation (simplified calculation)
resid <- residuals(model)
dw_stat <- sum(diff(resid)^2) / sum(resid^2)
return(list(
shapiro_p = shapiro_p,
dw_stat = dw_stat
))
}
# Run diagnostics
diagnostics_results <- data.frame()
for (s in unique(df$Season)) {
sub_data <- df %>% filter(Season == s) %>% arrange(date)
for (i in seq_along(vars)) {
v <- vars[i]
label <- var_labels[i]
x <- sub_data[[v]]
if (length(x) >= 8) {
diag <- get_ols_diagnostics(x)
diagnostics_results <- rbind(diagnostics_results, data.frame(
Season = s,
Variable = label,
Shapiro_p = round(diag$shapiro_p, 4),
DW_statistic = round(diag$dw_stat, 4)
))
}
}
}
# Interpret diagnostics
diagnostics_results <- diagnostics_results %>%
mutate(
Normality = ifelse(Shapiro_p > 0.05, "Normal (p > 0.05)", "Non-normal (p < 0.05)"),
Autocorrelation = case_when(
DW_statistic < 1.5 ~ "Positive autocorrelation",
DW_statistic > 2.5 ~ "Negative autocorrelation",
TRUE ~ "No significant autocorrelation"
)
)
diagnostics_results %>%
select(Season, Variable, Shapiro_p, Normality, DW_statistic, Autocorrelation) %>%
kable(
format = "html",
caption = "OLS Regression Diagnostics: Normality and Autocorrelation Tests",
col.names = c("Season", "Variable", "Shapiro-Wilk p", "Normality Status", "Durbin-Watson", "Autocorrelation Status"),
digits = 4
) %>%
kable_styling(full_width = FALSE, bootstrap_options = c("striped", "hover")) %>%
footnote(
general = "Shapiro-Wilk test: p > 0.05 suggests normally distributed residuals. Durbin-Watson statistic: values near 2 indicate no autocorrelation; values < 1.5 suggest positive autocorrelation; values > 2.5 suggest negative autocorrelation. Non-normal residuals or autocorrelation may invalidate OLS inference, supporting the use of the Mann–Kendall test.",
general_title = "Note:"
)
knitr::opts_chunk$set(echo = TRUE)
library(readr)
library(dplyr)
library(Kendall)
library(trend)
library(knitr)
library(kableExtra)
library(ggplot2)
library(tidyr)
df <- read_csv("CLIMATE DAR DATASET.csv")
df$date <- as.Date(paste(df$Year, df$Month, "01", sep = "-"), format="%Y-%b-%d")
vars <- c("rainfall_mm",
"daytime_temperature_celcius",
"nighttime_temperature_celcius",
"relative_humidity_%")
var_labels <- c("Rainfall (mm)",
"Daytime Temperature (°C)",
"Nighttime Temperature (°C)",
"Relative Humidity (%)")
run_mk <- function(x) {
mk <- MannKendall(x)
sen_result <- sens.slope(x)
sen <- sen_result$estimates
sen_ci <- sen_result$conf.int
S <- mk$S
varS <- mk$varS
if (varS > 0) {
if (S > 0) {
Z <- (S - 1) / sqrt(varS)
} else if (S == 0) {
Z <- 0
} else {
Z <- (S + 1) / sqrt(varS)
}
} else {
Z <- 0
}
return(list(Z = Z, p = mk$sl, slope = sen, ci_lower = sen_ci[1], ci_upper = sen_ci[2]))
}
results <- data.frame()
for (s in unique(df$Season)) {
sub_data <- df %>% filter(Season == s) %>% arrange(date)
for (i in seq_along(vars)) {
v <- vars[i]
label <- var_labels[i]
x <- sub_data[[v]]
if (length(x) >= 8) {
mkout <- run_mk(x)
results <- rbind(results, data.frame(
Season = s,
Variable = label,
Z = round(mkout$Z, 4),
p_value = round(mkout$p, 5),
Sen_slope = round(mkout$slope, 5),
CI_lower = round(mkout$ci_lower, 5),
CI_upper = round(mkout$ci_upper, 5)
))
}
}
}
# Calculate Bonferroni correction
n_tests <- nrow(results)
results$p_value_bonferroni <- pmin(results$p_value * n_tests, 1)
results %>%
mutate(
Sen_slope_CI = paste0(round(Sen_slope, 5), " [", round(CI_lower, 5), ", ", round(CI_upper, 5), "]"),
p_value_corrected = round(p_value_bonferroni, 5)
) %>%
select(Season, Variable, Z, p_value, p_value_corrected, Sen_slope_CI) %>%
kable(
format = "html",
caption = "Mann–Kendall Trend Test Results for Seasonal Climatic Variables (2014–2024)",
col.names = c("Season", "Variable", "Z-Score", "p-value", "p-value (Bonferroni)", "Sen's slope [95% CI]"),
digits = 5
) %>%
kable_styling(full_width = FALSE, bootstrap_options = c("striped", "hover"))
library(dplyr)
library(knitr)
library(kableExtra)
power_slope_ols <- function(x, alpha = 0.05, power_target = 0.80){
x <- x[!is.na(x)]
n <- length(x)
if(n < 8) return(NULL)
t <- 1:n
fit <- lm(x ~ t)
sigma <- summary(fit)$sigma
Sxx <- sum((t - mean(t))^2)
se_b <- sigma / sqrt(Sxx)
# Approximate MDT for target power (two-sided)
tcrit <- qt(1 - alpha/2, df = n - 2)
tpow  <- qt(power_target, df = n - 2)
mdt <- (tcrit + tpow) * se_b
list(n=n, sigma=sigma, se_b=se_b, MDT=mdt)
}
power_for_given_slope <- function(x, slope, alpha = 0.05){
x <- x[!is.na(x)]
n <- length(x)
if(n < 8) return(NA_real_)
t <- 1:n
fit <- lm(x ~ t)
sigma <- summary(fit)$sigma
Sxx <- sum((t - mean(t))^2)
se_b <- sigma / sqrt(Sxx)
tcrit <- qt(1 - alpha/2, df = n - 2)
ncp <- abs(slope) / se_b
# Normal approximation to power
pnorm(ncp - tcrit) + pnorm(-ncp - tcrit)
}
power_table <- data.frame()
for (s in unique(df$Season)) {
sub_data <- df %>% filter(Season == s) %>% arrange(date)
for (i in seq_along(vars)) {
v <- vars[i]
label <- var_labels[i]
x <- sub_data[[v]]
out <- power_slope_ols(x, alpha = 0.05, power_target = 0.80)
if(!is.null(out)){
obs <- results %>% filter(Season == s, Variable == label)
obs_sen <- if(nrow(obs) > 0) as.numeric(obs$Sen_slope[1]) else NA_real_
obs_power <- if(!is.na(obs_sen)) power_for_given_slope(x, obs_sen, alpha = 0.05) else NA_real_
power_table <- rbind(power_table, data.frame(
Season = s,
Variable = label,
n = out$n,
Residual_SD = out$sigma,
MDT_80pct = out$MDT,
Observed_SenSlope = obs_sen,
Power_for_Observed = obs_power
))
}
}
}
power_table_fmt <- power_table %>%
mutate(
Residual_SD = round(Residual_SD, 3),
MDT_80pct = round(MDT_80pct, 4),
Observed_SenSlope = round(Observed_SenSlope, 4),
Power_for_Observed = round(Power_for_Observed, 2)
)
power_table_fmt %>%
kable(
format = "html",
caption = "Minimum Detectable Trend (MDT) at 80% power and approximate power for observed Sen slopes (OLS-based approximation; α=0.05).",
col.names = c("Season", "Variable", "n", "Residual SD", "MDT (80% power)", "Observed Sen slope", "Power for observed slope")
) %>%
kable_styling(full_width = FALSE, bootstrap_options = c("striped", "hover")) %>%
footnote(
general = "MDT is the smallest trend magnitude expected to be detected with ~80% power at α=0.05 under an OLS approximation. Power values are approximate and are used to contextualize non-significant findings (e.g., relative humidity) as potentially underpowered rather than confirming stability.",
general_title = "Note:"
)
